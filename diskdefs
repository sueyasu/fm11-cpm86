# FM-11 CP/M-86 2D floppy, raw 320 KiB image.
# Matches src/cbios.asm dpb_2d and tests/build_boot_2d.py.
#
# Physical: 40 cylinders, 2 sides, 16 sectors/side, 256 bytes/sector.
# Raw order: cylinder 0 side 0, cylinder 0 side 1, cylinder 1 side 0, ...
# CP/M:     80 side-tracks, 16 physical sectors/track (=32 x 128-byte records).
# Reserved: first 4 side-tracks (16 KiB); directory begins at byte 0x4000.
# Filesystem: 2048-byte blocks, 64 directory entries, one directory block.
# No sector skew or per-image header.
#
# Read with:
#   cpmls -f fm11-cpm86-2d -d diskdefs build/fm11_cpm86_2d.raw
#   cpmls -f fm11-cpm86-2d -d diskdefs -l build/fm11_cpm86_2d.raw
# Copy a file out (do not edit original while debugging):
#   cpmcp -f fm11-cpm86-2d -d diskdefs build/fm11_cpm86_2d.raw 0:ASM86.CMD .
diskdef fm11-cpm86-2d
  seclen 256
  tracks 80
  sectrk 16
  blocksize 2048
  maxdir 64
  boottrk 4
  skew 0
  os 2.2
end

# FM-11 native 2HD CP/M-86 unpadded raw image (1021696 bytes).
# The first physical side is 26x128 FM (IPL); all others are 26x256 MFM.
# CP/M OFF=4 skips cylinders 0 and 1; filesystem begins at C2/H0.
# cpmtools sees only the 150 uniform filesystem side-tracks, after
# 26*128 + 3*26*256 = 23296 (0x5b00) bytes of reserved system area.
# DPB: SPT=52, BSH=5, BLM=31, EXM=3, DSM=242, DRM=63, CKS=16.
diskdef fm11-cpm86-2hd
  seclen 256
  tracks 150
  sectrk 26
  blocksize 4096
  maxdir 64
  boottrk 0
  offset 23296
  skew 0
  os 2.2
end
